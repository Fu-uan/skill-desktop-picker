{
  "name": "skill-desktop-picker",
  "version": "0.1.0",
  "description": "A floating desktop skill picker for Codex, Claude Code, Hermes and OpenClaw.",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "unzipper": "0.12.5",
    "yaml": "^2.8.0"
  },
  "build": {
    "appId": "io.github.fu-uan.skill-desktop-picker",
    "productName": "Skill Desktop Picker",
    "asar": false,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "dist"
    }
  }
}
